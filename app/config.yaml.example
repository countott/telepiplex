# Telepiplex 主配置；运行时唯一编辑入口为 /config/config.yaml。
# 升级时保留原主配置，预检将原设置迁入新版布局。
# /config 确认保存与 115 授权刷新均写入本文件，未安装插件也可预先配置。
# shared.tmdb.api_key 填写 API Read Access Token，Search 与 Sync 共用。
config_version: 3
bot_token: your_bot_token
allowed_user: 123456789
log_level: info
plugins:
  root: /config/plugins
  runtime_root: /tmp/telepiplex
  catalog: https://raw.githubusercontent.com/countott/telepiplex/catalog/catalog.yaml
  catalog_refresh_interval: 21600
  install_timeout: 300
  startup_timeout: 30
  drain_timeout: 120
  stabilize_seconds: 10
  restart_limit: 3
  event_retry_interval: 1
  event_delivery_timeout: 1800
  event_max_attempts: 5
shared:
  directories:
    live_action_movie:
      name: 真人电影
      path: /真人电影
    animated_movie:
      name: 动画电影
      path: /动画电影
    live_action_series:
      name: 真人剧集
      path: /真人剧集
    animated_series:
      name: 动画剧集
      path: /动画剧集
    unorganized_inventory:
      name: 额外盘点
      path: /未整理
    standalone_subtitles:
      name: 独立字幕导出
      path: /字幕
  directory_roles:
    media_categories:
      live_action_movie:
        directory_id: live_action_movie
        label: 真人电影
        plex_library_id: ''
      animated_movie:
        directory_id: animated_movie
        label: 动画电影
        plex_library_id: ''
      live_action_series:
        directory_id: live_action_series
        label: 真人剧集
        plex_library_id: ''
      animated_series:
        directory_id: animated_series
        label: 动画剧集
        plex_library_id: ''
    manual_downloads: []
    unorganized_inventory:
      directory_id: unorganized_inventory
    standalone_subtitles:
      directory_id: standalone_subtitles
  tmdb:
    api_key: ''
features:
  download:
    base_url: https://proapi.115.com
    passport_url: https://passportapi.115.com
    auth_mode: direct
    access_token: ''
    refresh_token: ''
    app_id: ''
    auth_poll_timeout: 300
    auth_poll_interval: 2
    timeout: 30
    download_timeout: 1800
    minimum_video_size_mib: 100
    poll_initial_interval: 2
    poll_max_interval: 30
    poll_backoff_factor: 1.7
    endpoint_intervals:
      offline_poll: 1.0
      offline_mutation: 1.0
      storage_read: 0.25
      storage_mutation: 1.0
      token_refresh: 1.0
    storage_read_workers: 4
    enable_tree_snapshot_references: false
  search:
    metadata:
      wikipedia:
        enable: true
        languages:
        - zh
        - en
        timeout: 10
        min_interval: 3
        max_queries: 2
        rate_limit_cooldown: 30
      douban:
        enable: true
        timeout: 10
        cache_ttl: 900
        max_concurrency: 2
        circuit_breaker_failures: 3
        circuit_breaker_seconds: 300
      tvdb:
        enable: true
        api_key: ''
        base_url: https://api4.thetvdb.com/v4
        subscriber_pin: ''
        timeout: 15
      tmdb:
        enable: true
        base_url: https://api.themoviedb.org/3
        timeout: 15
      anilist:
        enable: true
        endpoint: https://graphql.anilist.co
        timeout: 15
    prowlarr:
      base_url: http://127.0.0.1:9696
      api_key: ''
      timeout: 200
      indexer_timeout: 75
      status_timeout: 15
      indexer_ids: '-2'
      first_wave_indexer_ids: []
      wave_delay: 1.5
      categories:
        movie: 2000
        tv: 5000
      result_limit: 12
    scoring:
      reject_keywords:
      - 720p
      - 576p
      - 480p
      - CAM
      - TS
      - TC
      - 枪版
      - 抢先
      - HC
      - HDTC
      - HDCAM
      keyword_scores:
        2160p: 100
        1080p: 50
        BluRay: 12
        BDRip: 10
        WEB: 6
        Remux: -1
        HEVC: 2
        H.265: 2
        x265: 2
        H.264: 1
        x264: 1
        Atmos: 20
        TrueHD: 4
        DTS-HD: 3
        EAC3: 2
        国配: 2
        中字: 1
      indexer_scores:
        M-Team: 3
        TorrentLeech: 1
  rename:
    storage_timeout: 120
    storage_move_batch_size: 100
    metadata_timeout: 120
    selection:
      movie_size_fallback_ratio: 1.5
      unmatched_large_ratio: 0.25
      unmatched_large_min_bytes: 314572800
    ai:
      enable: true
      api_url: ''
      api_key: ''
      model: ''
      timeout: 60
    caption_stage_timeout_seconds: 300
  sync:
    plex:
      base_url: ''
      token: ''
      timeout: 15
      scan_poll_interval: 5
      scan_timeout: 300
    tmdb:
      timeout: 15
    fanart:
      api_key: ''
      timeout: 15
    mcp:
      enabled: false
      host: 127.0.0.1
      port: 8765
      path: /mcp
      auth_token: ''
  caption:
    enabled: true
    automatic: true
    source_profile: balanced
    request_timeout_seconds: 15
    provider_timeout_seconds: 45
    retrieval_timeout_seconds: 180
    automatic_timeout_seconds: 240
    max_candidates: 30
    max_candidates_per_provider: 15
    max_download_bytes: 16777216
    providers:
      assrt:
        enabled: true
        token: ''
      shooter:
        enabled: true
      subhd:
        enabled: true
        cookie: ''
        user_agent: ''
      zimuku:
        enabled: true
        cookie: ''
        user_agent: ''
      opensubtitles:
        enabled: true
        api_key: ''
        username: ''
        password: ''
        token: ''
      xunlei:
        enabled: true
      subdl:
        enabled: true
        api_key: ''
      subsource:
        enabled: true
        api_key: ''
      subf2m:
        enabled: true
      r3sub:
        enabled: true
      addic7ed:
        enabled: true
        cookie: ''
        user_agent: ''
      lwltv:
        enabled: true
        cookie: ''
        user_agent: ''
      yysub:
        enabled: true
        cookie: ''
        user_agent: ''
      nekomoe:
        enabled: true
        title_aliases: {}
        episode_mappings: {}
      mingy:
        enabled: true
        max_release_pages: 3
        title_aliases: {}
        episode_mappings: {}
      kitauji:
        enabled: true
        title_aliases: {}
        episode_mappings: {}
      haruhana:
        enabled: true
        title_aliases: {}
        episode_mappings: {}
      local_archive:
        enabled: true
        roots: []
        mapping_file: ''
        cache_ttl_seconds: 300
        max_files: 20000
        max_depth: 12
        episode_mappings: {}
    provider_defaults:
      github:
        github_token: ''
        cache_ttl_seconds: 3600
