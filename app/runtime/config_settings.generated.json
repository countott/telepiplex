        "catalog_refresh_interval": 21600,
        "install_timeout": 300,
        "startup_timeout": 30,
        "drain_timeout": 120,
        "stabilize_seconds": 10,
        "restart_limit": 3,
        "event_retry_interval": 1,
        "event_delivery_timeout": 1800,
        "event_max_attempts": 5
      }
    },
    "schema": {
      "type": "object",
      "properties": {
        "log_level": {
          "type": "string"
        },
        "bot_token": {
          "type": "string",
