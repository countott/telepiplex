                    "title": "优先音频",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reject_keywords": {
                    "type": "array",
                    "title": "拒绝关键词",
                    "description": "命中即排除，不扣分。分辨率关键词也匹配解析后的像素尺寸别名。",
                    "items": {
                      "type": "string"
                    }
                  },
                  "keyword_scores": {
                    "type": "object",
                    "title": "关键词权重",
