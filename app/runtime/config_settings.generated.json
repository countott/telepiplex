              "type": "number"
            },
            "drain_timeout": {
              "type": "number"
            },
            "stabilize_seconds": {
              "type": "number"
            },
            "restart_limit": {
              "type": "integer"
            },
            "event_retry_interval": {
              "type": "number"
            },
            "event_delivery_timeout": {
              "type": "number"
            },
            "event_max_attempts": {
              "type": "integer"
            }
          }
        }
      }
