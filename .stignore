(?d)**/build
(?d)**/dist
(?d)**/*.egg-info

// Editor and review scratch state
(?d)**/.idea
(?d)**/.vscode
(?d)**/.superpowers/sdd

// macOS metadata
(?d).DS_Store
(?d)**/.DS_Store
